{
  "name": "@vansh2k6/spider-overlay",
  "version": "0.1.0",
  "description": "A cursor-following spider UI component with interactive silk webs for React and vanilla JavaScript.",
  "keywords": ["cursor-following-spider", "spider", "react-component", "ui-component", "canvas", "cursor-effects", "web-animation"],
  "author": {
    "name": "Vansh Singh",
    "url": "https://github.com/Vansh2k6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vansh2k6/spider-overlay.git"
  },
  "bugs": {
    "url": "https://github.com/Vansh2k6/spider-overlay/issues"
  },
  "homepage": "https://github.com/Vansh2k6/spider-overlay#readme",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./style.css": "./dist/overlay.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
